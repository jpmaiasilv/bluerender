# Backend is hosted on Render (Express server, not static files) — these
# proxy rules must come BEFORE the SPA fallback below, since _redirects
# rules are matched top to bottom and the fallback would otherwise swallow
# every one of these paths and serve index.html instead.
/api/*       https://bluerender.onrender.com/api/:splat       200
/results/*   https://bluerender.onrender.com/results/:splat   200
/uploads/*   https://bluerender.onrender.com/uploads/:splat   200

# SPA fallback: this is a React Router app — every route needs to resolve to
# index.html so client-side routing can take over, otherwise a direct link or
# an F5 on any route other than "/" (e.g. /render, /planta-humanizada) 404s.
/*   /index.html   200
