# Black Forest Labs API key (required).
# Create one at https://dashboard.bfl.ai/get-started
BFL_API_KEY=

# xAI API key (required for Vídeo IA — Grok Imagine Video).
# Create one at https://console.x.ai
XAI_API_KEY=

# Optional overrides
PORT=8787
BFL_BASE_URL=https://api.bfl.ai
BFL_POLL_TIMEOUT_MS=180000
XAI_BASE_URL=https://api.x.ai
XAI_POLL_TIMEOUT_MS=300000

# Path used for the "FLUX.2 Pro" model. Defaults to /v1/flux-2-pro-preview
# (what BFL's own Playground "view code" currently uses). If BFL renames or
# retires this and the app starts getting 404s, try /v1/flux-2-pro instead
# (the path documented in BFL's official skills repo) by setting this var.
# BFL_FLUX2_PRO_PATH=/v1/flux-2-pro

# --- Credits, history and file storage (Supabase is the source of truth) ---
# Apply supabase/migrations/*.sql to the project first (see the migration files).
# NODE_ENV=production makes Supabase (database + Storage + auth) mandatory: the
# server refuses to start without SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY and
# never falls back to memory, JSON files or local disk.
# NODE_ENV=

# DEV ONLY: explicit opt-in to a local, NON-persistent fallback (in-memory wallet,
# JSON history, files on local disk) when Supabase is not migrated yet. Ignored /
# rejected in production. The server logs a loud banner whenever it is active.
# ALLOW_LOCAL_DEV_FALLBACK=true

# Credits granted ONCE to a brand-new wallet. Defaults: 0 in production, 100 in development.
# WALLET_SIGNUP_BONUS_CREDITS=

# Minutes a reservation may stay unsettled before reconciliation looks at it (default 20).
# WALLET_RESERVATION_STALE_MINUTES=

# Provider timeout for one humanized floor plan generation, in ms (default 300000).
# HUMANIZED_FLOORPLAN_REQUEST_TIMEOUT_MS=

# Secret used to sign local-fallback file links (dev fallback only; random per process if unset).
# HUMANIZED_FILE_SIGNING_SECRET=

# OpenAI image prices in USD per 1,000,000 tokens, for cost tracking. Never guessed:
# leave unset and the recorded cost stays null.
# OPENAI_IMAGE_PRICE_TEXT_INPUT_PER_M=
# OPENAI_IMAGE_PRICE_IMAGE_INPUT_PER_M=
# OPENAI_IMAGE_PRICE_IMAGE_OUTPUT_PER_M=

# --- GPT-6 Astra mode of Planta Humanizada (10 credits) ---
# The premium mode stays OFF unless this is exactly "true". It also needs OPENAI_API_KEY and
# the Supabase wallet/history/storage infrastructure to be reachable.
# HUMANIZED_FLOORPLAN_ASTRA_ENABLED=true
# OPENAI_ASTRA_MODEL=gpt-6-astra
# OPENAI_ASTRA_TIMEOUT_MS=120000
# Minimum fidelity score (0-100) to APPROVE / to still DELIVER a candidate (defaults 85 / 70).
# HUMANIZED_FLOORPLAN_ASTRA_APPROVAL_SCORE=85
# HUMANIZED_FLOORPLAN_ASTRA_MIN_DELIVERABLE_SCORE=70
# Astra prices, USD per 1,000,000 tokens. Never guessed: unset => recorded cost is null.
# OPENAI_ASTRA_INPUT_PRICE_PER_M=
# OPENAI_ASTRA_CACHED_INPUT_PRICE_PER_M=
# OPENAI_ASTRA_OUTPUT_PRICE_PER_M=

# --- Arquiteto Estagiário chat assistant (1 credit per message) ---
# Stays OFF unless this is exactly "true". Also needs OPENAI_API_KEY and the
# Supabase wallet/history/storage infrastructure to be reachable.
# ARCHITECT_CHAT_ENABLED=true
# OPENAI_ARCHITECT_CHAT_MODEL=gpt-5.6-sol
# OPENAI_ARCHITECT_CHAT_TIMEOUT_MS=120000
# OPENAI_ARCHITECT_CHAT_MAX_OUTPUT_TOKENS=2048
# Audio attachments are transcribed before reaching the chat model.
# OPENAI_ARCHITECT_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_ARCHITECT_TRANSCRIBE_TIMEOUT_MS=60000
# Prices, USD per 1,000,000 tokens (audio: per minute). Never guessed: unset => recorded cost is null.
# OPENAI_ARCHITECT_CHAT_INPUT_PRICE_PER_M=
# OPENAI_ARCHITECT_CHAT_CACHED_INPUT_PRICE_PER_M=
# OPENAI_ARCHITECT_CHAT_OUTPUT_PRICE_PER_M=
# OPENAI_ARCHITECT_TRANSCRIBE_PRICE_PER_MINUTE=
